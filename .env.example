# Optional. Forge works manually without a key. Read only by the local backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# FORGE_DB_PATH=./data/forge.sqlite
# PORT=4310
# Context budgets are configurable starting points, measured in UTF-8 JSON bytes.
# FORGE_CONTEXT_BYTES=131072
# FORGE_REQUEST_BYTES=196608
# Reserve output tokens within the model's supported capacity.
# FORGE_OUTPUT_TOKENS=8192
# GPT-4.1 and GPT-6.1 Sol have verified context/output profiles. For other models set
# a verified capacity; otherwise Forge uses a conservative 32768-token ceiling.
# FORGE_MODEL_CONTEXT_TOKENS=32768
# Unknown models use a conservative byte bound unless an encoding is verified.
# FORGE_TOKENIZER=byte-bound
