{
  "name": "forge-design-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-placeholder": "^3.6.0",
    "@tiptap/react": "^3.6.0",
    "@tiptap/starter-kit": "^3.6.0",
    "fastify": "^5.6.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
